# Core application and SQL Server
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_BASE_URL=http://localhost:3000
ACCEPT_EULA=Y
MSSQL_USER=sa
MSSQL_SA_PASSWORD=ChangeThis_SqlServerPassword_123!
TRIPLY_DB_CONNECTION=Server=triply-db,1433;Database=Triply;User Id=sa;Password=ChangeThis_SqlServerPassword_123!;TrustServerCertificate=True;Encrypt=False

# JWT authentication: use a long, unique random SECRETKEY.
ISSUER=Triply
AUDIENCE=TriplyClient
SECRETKEY=ChangeThis_To_A_Long_Random_Secret_Key_At_Least_32_Characters
VALIDATE_AUDIENCE=true
VALIDATE_ISSUER=true
VALIDATE_LIFETIME=true
VALIDATE_ISSUER_SIGNING_KEY=true
EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# Redis
REDIS_PASSWORD=ChangeThis_RedisPassword_123!

# RabbitMQ
RABBITMQ_HOSTNAME=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=triply
RABBITMQ_PASSWORD=ChangeThis_RabbitMqPassword_123!
RABBITMQ_EXCHANGE=triply.events
RABBITMQ_EMAIL_QUEUE=triply.email
RABBITMQ_IMAGE_QUEUE=triply.images
RABBITMQ_DEAD_LETTER_EXCHANGE=triply.dead-letter
RABBITMQ_EMAIL_DEAD_LETTER_QUEUE=triply.email.dead-letter
RABBITMQ_IMAGE_DEAD_LETTER_QUEUE=triply.images.dead-letter
RABBITMQ_MAX_RETRY_COUNT=3
RABBITMQ_RETRY_DELAY=5000

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Triply
SMTP_USE_SSL=true

# Cloudinary image upload
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
UPLOADS_PATH=/app/uploads
UPLOADS_MAX_FILE_SIZE=10485760

# Payments. Use Mock locally, or Stripe with valid Stripe credentials.
PROVIDER_ID=Mock
CURRENCY=usd
SUCCESS_URL=http://localhost:3000/booking/{CONFIRMATION_NUMBER}?payment=success
CANCEL_URL=http://localhost:3000/booking/{CONFIRMATION_NUMBER}?payment=cancelled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Booking expiry, filtering, and observability
BOOKING_PENDING_EXPIRY_MINUTES=45
BOOKING_EXPIRY_CHECK_INTERVAL_MINUTES=5
SIEVE_CASE_SENSITIVE=false
SIEVE_DEFAULT_PAGE_SIZE=10
SIEVE_MAX_PAGE_SIZE=50
SLOW_QUERY_THRESHOLD_MS=500
ELASTICSEARCH_ENABLED=true
